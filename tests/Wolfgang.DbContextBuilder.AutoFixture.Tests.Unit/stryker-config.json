{
  "stryker-config": {
    "project": "Wolfgang.DbContextBuilder.AutoFixture.csproj",
    "target-framework": "net10.0",
    "ignore-methods": [
      "ConfigureAwait"
    ],
    "reporters": [
      "progress",
      "html",
      "json"
    ],
    "thresholds": {
      "high": 95,
      "low": 90,
      "break": 0
    },
    "coverage-analysis": "perTestInIsolation",
    "since": {
      "enabled": false,
      "ignore-changes-in": [
        "**/.github/**",
        "**/docs/**",
        "**/changelog/**",
        "**/*.md",
        "**/PublicAPI.*.txt",
        "**/mutation-floors.json"
      ]
    }
  }
}
