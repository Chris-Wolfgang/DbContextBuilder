<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Wolfgang.DbContextBuilderEF6.Tests.Unit</RootNamespace>
		<TargetFrameworks>net462;net47;net471;net472;net48;net481</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<ItemGroup>
		<!-- No coverlet.collector: from 8.0 it ships only net8.0+ builds and cannot load in a
		     .NET Framework test host, and this project targets only net4x. pr.yaml Stage 2 and
		     build-pr.ps1 measure it with Microsoft's collector (Microsoft.NET.Test.Sdk) instead (#523). -->
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<!-- Capped: xunit.runner.visualstudio 3.x drops .NET Framework (#581). -->
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" allowedVersions="(,3.0.0)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Wolfgang.DbContextBuilder-EF6\Wolfgang.DbContextBuilder-EF6.csproj" />
	</ItemGroup>

	<PropertyGroup>
		<!-- CA1707 (underscores) is intentional: test method names follow the MethodUnderTest_when_condition_expected_result convention. -->
		<!--
		  CS1591 (missing XML doc) suppressed: the classic EF6 test
		  classes pre-date the XML-doc convention used by the EF Core
		  test files. Adding XML docs to ~30 test classes / ~150 members
		  is a separate follow-up; until then, suppress to keep
		  TreatWarningsAsErrors=Release green now that
		  tests/Directory.Build.props is gone.
		-->
		<NoWarn>$(NoWarn);CA1707;CS1591</NoWarn>
	</PropertyGroup>

  <!-- Analyzer PackageReferences are centralized in Directory.Build.props -->

</Project>
