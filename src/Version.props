<Project>
	<!-- The single source of the release version for every src project. The packages ship in
	     lockstep, so bump <Version> here once per release; no src csproj may set its own
	     (release.yaml rejects one that does, and rejects a tag that does not equal this value).

	     This is deliberately not Directory.Build.props: that file is protected, so a bump there
	     would need an admin bypass, and pr.yaml builds a PR with main's copy of it, so CI would
	     never pack the bumped version. Every src csproj imports this file instead. -->
	<PropertyGroup>
		<Version>0.9.0</Version>

		<!-- Pin AssemblyVersion to a fixed binding-stability baseline so consumers do not need to
		     recompile / add binding redirects on every minor/patch bump. Bump only on a deliberate
		     breaking API change. FileVersion and InformationalVersion (the latter auto-derived from
		     <Version>) carry the actual release version. -->
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>$([System.Text.RegularExpressions.Regex]::Replace("$(Version)", "[-+].*$", "")).0</FileVersion>

		<!-- The published version that package validation compares against. Advance it in a
		     follow-up PR once the new release is on nuget.org, not in the release PR itself (the
		     restore fails with NU1102 until the package is indexed). Ignored by projects that set
		     EnablePackageValidation to false. -->
		<PackageValidationBaselineVersion>0.9.0</PackageValidationBaselineVersion>
	</PropertyGroup>
</Project>
