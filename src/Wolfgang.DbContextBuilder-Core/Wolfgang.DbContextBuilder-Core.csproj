<Project Sdk="Microsoft.NET.Sdk">
	<!-- Version, AssemblyVersion and the PackageValidation baseline: one shared copy for the lockstep packages. -->
	<Import Project="..\Version.props" />
	<PropertyGroup>
		<RootNamespace>Wolfgang.DbContextBuilderCore</RootNamespace>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Title>Wolfgang.DbContextBuilder for EF</Title>
		<Description>A library for easily building DbContext for testing using in-memory database</Description>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>

		<SignAssembly>False</SignAssembly>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Retired as a shipped package (#362). It duplicated -Core-EF6 - same EF Core 6, different
		     runtime TFM - and net10.0 + EF Core 6 is an odd pairing nobody should be reaching for:
		     EF Core 6 consumers want -Core-EF6, net10 consumers want -Core-EF10.
		
		     The PROJECT stays. It is the canonical source the five -Core-EFx wrappers <Compile Include>
		     link, so deleting it would gut all of them. Only its packability changes.
		
		     Already-published versions stay on NuGet - existing consumers must keep resolving them.
		     Marking the package deprecated on nuget.org is a separate manual step. -->
		<IsPackable>false</IsPackable>
		<!-- Nothing is packed any more, so there is no package to validate against the baseline. -->
		<EnablePackageValidation>false</EnablePackageValidation>
		<IsTestProject>false</IsTestProject>
		<DefineConstants>$(DefineConstants);EF_CORE_6;EF_CORE_6_OR_GREATER</DefineConstants>
	</PropertyGroup>
	<ItemGroup>
	  <!-- Lock EF to version 6.x but not 7 or later -->
	  <PackageReference Include="Microsoft.EntityFrameworkCore" Version="[6.0.36,7.0.0)" />
	  <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="[6.0.36,7.0.0)" />
	  <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="[6.0.36,7.0.0)" />
	  <!-- Pin SQLite native lib above SQLitePCLRaw.lib.e_sqlite3 2.1.2 (GHSA-2m69-gcr7-jv3q / NU1903). -->
	  <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
	</ItemGroup>
  <!-- Analyzer PackageReferences are centralized in Directory.Build.props -->
	<ItemGroup>
		<ProjectReference Include="../Wolfgang.DbContextBuilder.Abstractions/Wolfgang.DbContextBuilder.Abstractions.csproj" />
	</ItemGroup>
</Project>
