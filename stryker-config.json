{
  "stryker-config": {
    "solution": "Wolfgang.DbContextBuilder.slnx",
    "target-framework": "net10.0",
    "mutate": [
      "**/*",
      "!**/extra-projects/**"
    ],
    "ignore-methods": [
      "ConfigureAwait"
    ],
    "reporters": [
      "progress",
      "html",
      "json"
    ],
    "thresholds": {
      "high": 90,
      "low": 78,
      "break": 75
    },
    "coverage-analysis": "perTestInIsolation",
    "since": {
      "enabled": false,
      "ignore-changes-in": [
        "**/.github/**",
        "**/docs/**",
        "**/changelog/**",
        "**/*.md",
        "**/PublicAPI.*.txt",
        "**/mutation-floors.json"
      ]
    }
  }
}
