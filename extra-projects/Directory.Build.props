<Project>
  <!-- extra-projects (the scaffolded AdventureWorks sample databases) deliberately do NOT
       inherit the root Directory.Build.props: this file stops MSBuild's upward search and has no
       <Import> of the root, so none of the root's analyzers, BannedSymbols.txt, Nullable or
       LangVersion settings apply here (#579). Only the settings below do. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <!-- Same reasons as the root props (#578): the net6.0/net7.0 projects (AdventureWorks-EF6/EF7)
         are deliberate, so silence the MSBuild-level TFM-support and EOL (NETSDK1138) warnings. -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>
</Project>
